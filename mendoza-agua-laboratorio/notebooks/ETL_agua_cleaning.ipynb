            ]
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# 3. Iteración y limpieza\n",
        "filas_limpias = []\n",
        "\n",
        "for idx, row in df_raw.iterrows():\n",
        "    fecha = str(row.iloc[0]).strip() if pd.notnull(row.iloc[0]) else ''\n",
        "    lugar = str(row.iloc[1]).strip() if pd.notnull(row.iloc[1]) else ''\n",
        "    depto = str(row['DEPTO']).strip() if pd.notnull(row['DEPTO']) and str(row['DEPTO']).strip() != 'nan' else 'No Especificado'\n",
        "\n",
        "    # Categorías\n",
        "    tipo_muestra = consolidar_activos(row, muestras_cols)\n",
        "    if tipo_muestra == 'AGUA': tipo_muestra = 'Agua'\n",
        "    elif tipo_muestra == 'EFLUENTE': tipo_muestra = 'Efluente'\n",
        "\n",
        "    tipo_analisis = consolidar_activos(row, analisis_cols, mapa_analisis)\n",
        "    operador = consolidar_activos(row, operador_cols, mapa_operador)\n",
        "\n",
        "    # Normalización de observaciones (Factibilidad, mayúsculas iniciales, etc.)\n",
        "    obs = str(row.iloc[16]).strip() if pd.notnull(row.iloc[16]) else ''\n",
        "    if obs.lower() in ['nan', '']:\n",
        "        obs = ''\n",
        "    else:\n",
        "        # Corrección de \"factibilidad\" -> \"Factibilidad\" conservando el resto del texto si lo hay\n",
        "        if obs.lower().startswith('factibilidad'):\n",
        "            obs = 'Factibilidad' + obs[12:]\n",
        "        else:\n",
        "            obs = obs[0].upper() + obs[1:]\n",
        "\n",
        "    filas_limpias.append({\n",
        "        'Fecha': fecha,\n",
        "        'Lugar_Extraccion': lugar,\n",
        "        'Departamento': depto,\n",
        "        'Tipo_Muestra': tipo_muestra,\n",
        "        'Tipo_Analisis': tipo_analisis,\n",
        "        'Operador_Solicitante': operador,\n",
        "        'Observaciones': obs\n",
        "    })"
      ],
      "metadata": {
        "id": "dW7F7m3PM5kL"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# 4. Crear DataFrame y limpieza global de espacios sobrantes\n",
        "df_limpio = pd.DataFrame(filas_limpias)\n",
        "\n",
        "for col in df_limpio.columns:\n",
        "    df_limpio[col] = df_limpio[col].astype(str).str.strip()\n",
        "\n",
        "# 5. Guardar en ambos formatos (Excel nativo y CSV con ;)\n",
        "df_limpio.to_excel('datos-de-laboratorio-limpio-final.xlsx', index=False)\n",
        "df_limpio.to_csv('datos-de-laboratorio-limpio-final.csv', sep=';', index=False, encoding='utf-8-sig')\n",
