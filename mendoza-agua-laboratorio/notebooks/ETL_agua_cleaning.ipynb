      "cell_type": "code",
      "source": [
        "import pandas as pd"
      ],
      "metadata": {
        "id": "iPb3xHQGFcUU"
      },
      "execution_count": 27,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Función para consolidar celdas activas\n",
        "def consolidar_activos(row, columnas, mapa=None):\n",
        "    activos = []\n",
        "    for col in columnas:\n",
        "        val = row[col]\n",
        "        if pd.notnull(val) and str(val).strip() not in ['', '0', 'nan', 'NaN']:\n",
        "            nombre = mapa.get(col, col) if mapa else col\n",
        "            activos.append(nombre)\n",
        "    return \", \".join(activos) if activos else 'No Especificado'"
      ],
      "metadata": {
        "id": "4D-2dU8VMzQG"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# 1. Cargar el archivo original omitiendo la primera fila de títulos general\n",
        "archivo = \"/content/datos-de-laboratorio.csv\"\n" #o direccion donde este el archivo,
        "\n",
        "df_raw = pd.read_csv(archivo, sep=';', header=1, encoding='latin1')"
      ],
      "metadata": {
        "id": "HUaMy9vfIaQo"
      },
      "execution_count": 30,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# 2. Definir grupos de columnas y mapeos para estandarización\n",
        "muestras_cols = ['AGUA', 'EFLUENTE']\n",
        "analisis_cols = ['BACTER.', 'IN SITU', 'BASICO', 'COMPLETO']\n",
        "operador_cols = ['AySAM', 'O.G.C.', 'D.G.E.', 'D.G.I.', 'OTROS', 'P.T.L.C.', 'RECLAMO']\n",
        "\n",
        "mapa_analisis = {\n",
        "    'BACTER.': 'Bacteriológico',\n",
        "    'IN SITU': 'In Situ',\n",
        "    'BASICO': 'Básico',\n",
        "    'COMPLETO': 'Completo'\n",
        "}\n",
        "\n",
        "mapa_operador = {\n",
        "    'AySAM': 'AySAM',\n",
        "    'O.G.C.': 'O.G.C.',\n",
        "    'D.G.E.': 'D.G.E.',\n",
        "    'D.G.I.': 'D.G.I.',\n",
        "    'OTROS': 'Otros',\n",
        "    'P.T.L.C.': 'P.T.L.C.',\n",
        "    'RECLAMO': 'Reclamo'\n",
        "}"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 34
